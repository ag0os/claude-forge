{
  "name": "claude-forge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile-all.ts",
    "compile:forge": "bun build cli/forge.ts --compile --outfile bin/forge",
    "watch": "bun scripts/watch-agents.ts",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:all": "bun run typecheck && bun run check",
    "lint:fix": "biome check --write --unsafe .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "^2.1.2",
    "typescript": "^5.6.2",
    "husky": "^9.1.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.22"
  }
}
